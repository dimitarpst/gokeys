// Linked into gokeys.exe by build.gradle.kts (windres). Icons come from branding/make-logo.mjs.
1 ICON "branding/gokeys.ico"
2 ICON "branding/offline.ico"
3 ICON "branding/paused.ico"

1 24 "src/mingwX64Main/resources/gokeys.manifest" // RT_MANIFEST

// Roboto, cut down by make-logo.mjs; loaded privately at startup (RT_RCDATA).
10 RCDATA "branding/fonts/gokeys_regular.ttf"
11 RCDATA "branding/fonts/gokeys_medium.ttf"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "govrse"
      VALUE "FileDescription", "gokeys"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "gokeys"
      VALUE "OriginalFilename", "gokeys.exe"
      VALUE "ProductName", "gokeys"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
